# Shopify Admin API via the CARP app (apps/shopify). Scopes: read_products, read_metaobjects.
# Never commit the real values. Catalog field names go in config/shopify.local.toml.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=replace_me
SHOPIFY_API_VERSION=2026-07

# Pond node
CARP_POND_ID=pond-1
CARP_API_URL=http://localhost:8000
CARP_SPOOL_DIR=spool
